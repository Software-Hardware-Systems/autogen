// Hubber.cs

using System.Text.Json;
using DevTeam;
using DevTeam.Backend.Agents.DeveloperLead;
using DevTeam.Backend.Agents.ProductManager;
using DevTeam.Backend.Services;
using DevTeam.Backend.Messages;
using Microsoft.AutoGen.Contracts;
using Microsoft.AutoGen.Core;

namespace DevTeam.Backend.Agents;

/// <summary>
/// Handles GitHub-related workflows by creating issues, branches, and comments based on various
/// events generated by the GitHubWebHookProcessor in response to GitHubApp events.
/// </summary>
/// <param name="ghService">Used for managing GitHub operations like creating issues and branches.</param>
/// <param name="id">Identifies the agent within the system.</param>
/// <param name="runtime">Provides the execution context for the agent's operations.</param>
/// <param name="logger">Facilitates logging for tracking the agent's activities and errors.</param>
[TypeSubscription(SkillPersona.Hubber)]
public class Hubber(
    IManageGithub ghService,
    AgentId id,
    IAgentRuntime runtime,
    ILogger<Hubber>? logger = null)
    :
    BaseAgent(id, runtime, nameof(Hubber), logger),
    IHandle<StakeholderAsked>,
    IHandle<StakeholderAnswered>,
    IHandle<ReadmeGenerated>,
    IHandle<DevPlanGenerated>,
    IHandle<DevPlanCreated>,
    IHandle<ReadmeStored>,
    IHandle<CodeGenerated>,
    // Additional stakeholder message handlers
    IHandle<StakeholderClarified>,
    IHandle<StakeholderReviewed>,
    IHandle<ResponseToStakeholder>,
    IHandle<ValuePropositionProcessed>,
    IHandle<PrioritizationProcessed>,
    IHandle<SprintFeedbackProcessed>
{
    /// <summary>
    /// When the user creates a new Issue (StakeholderAsk), create two new issues:
    /// One for the PM to create a README.md file
    /// Another for the DevLead to create a plan
    /// Then create a new branch for the dev-team to work on
    /// Then post comments to the PM and DevLead issues with the links to the new issues
    /// The comments contain magic strings PM.Readme and DevLead.Plan to
    /// indicate which dev-team agent should handle the issue
    /// </summary>
    /// <param name="stakeholderAsk"></param>
    /// <param name="messageContext"></param>
    /// <returns></returns>
    public async ValueTask HandleAsync(StakeholderAsked stakeholderAsk, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);

        await ghService.CreateBranch(org, repo, $"sk-{issueNumber}");

        // Note that the newAsk user message is incorporated into both the PM and DevLead issues

        var pmIssue = await ghService.CreateIssue(org, repo, stakeholderAsk.Response, $"{SkillPersona.ProductOwner}.{nameof(PMSkills.Readme)}", issueNumber);
        await ghService.PostComment(org, repo, issueNumber, $" - #{pmIssue} - tracks {SkillPersona.ProductOwner}.{nameof(PMSkills.Readme)}");

        var devLeadIssue = await ghService.CreateIssue(org, repo, stakeholderAsk.Response, $"{SkillPersona.DeveloperLead}.{nameof(DeveloperLeadSkills.Plan)}", issueNumber);
        await ghService.PostComment(org, repo, issueNumber, $" - #{devLeadIssue} - tracks {SkillPersona.DeveloperLead}.{nameof(DeveloperLeadSkills.Plan)}");
    }

    public async ValueTask HandleAsync(StakeholderAnswered stakeholderAnswered, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);
        await ghService.PostComment(org, repo, issueNumber, stakeholderAnswered.Response);
        
        // Add follow-up question if needed
        if (stakeholderAnswered.RequiresFollowUp && !string.IsNullOrEmpty(stakeholderAnswered.FollowUpQuestion))
        {
            await ghService.PostComment(org, repo, issueNumber, $"Follow-up question: {stakeholderAnswered.FollowUpQuestion}");
        }
    }
    
    public async ValueTask HandleAsync(StakeholderClarified stakeholderClarified, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);
        
        // Post the main response
        await ghService.PostComment(org, repo, issueNumber, stakeholderClarified.Response);
        
        // Post understanding and questions if needed
        if (!string.IsNullOrEmpty(stakeholderClarified.Understanding))
        {
            await ghService.PostComment(org, repo, issueNumber, $"Understanding: {stakeholderClarified.Understanding}");
        }
        
        if (stakeholderClarified.ClarificationQuestions.Count > 0)
        {
            var questions = string.Join("\n- ", stakeholderClarified.ClarificationQuestions);
            await ghService.PostComment(org, repo, issueNumber, $"Clarification questions:\n- {questions}");
        }
        
        if (stakeholderClarified.MissingAspects.Count > 0)
        {
            var aspects = string.Join("\n- ", stakeholderClarified.MissingAspects);
            await ghService.PostComment(org, repo, issueNumber, $"Missing aspects to consider:\n- {aspects}");
        }
    }
    
    public async ValueTask HandleAsync(StakeholderReviewed stakeholderReviewed, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);
        
        // Post the main response
        await ghService.PostComment(org, repo, issueNumber, stakeholderReviewed.Response);
        
        // Add review status
        var status = stakeholderReviewed.Approved ? "✅ **Approved**" : "❌ **Not Approved**";
        await ghService.PostComment(org, repo, issueNumber, status);
        
        // Add requested changes if any
        if (stakeholderReviewed.ChangesRequested.Count > 0)
        {
            var changes = string.Join("\n- ", stakeholderReviewed.ChangesRequested);
            await ghService.PostComment(org, repo, issueNumber, $"Requested changes:\n- {changes}");
        }
        
        // Add next steps
        if (!string.IsNullOrEmpty(stakeholderReviewed.NextSteps))
        {
            await ghService.PostComment(org, repo, issueNumber, $"Next steps: {stakeholderReviewed.NextSteps}");
        }
    }
    
    public async ValueTask HandleAsync(ResponseToStakeholder responseToStakeholder, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);
        
        // Post the main response
        await ghService.PostComment(org, repo, issueNumber, responseToStakeholder.Response);
        
        // Post action taken
        if (!string.IsNullOrEmpty(responseToStakeholder.ActionTaken))
        {
            await ghService.PostComment(org, repo, issueNumber, $"Action taken: {responseToStakeholder.ActionTaken}");
        }
        
        // Post next steps
        if (responseToStakeholder.NextSteps.Count > 0)
        {
            var steps = string.Join("\n- ", responseToStakeholder.NextSteps);
            await ghService.PostComment(org, repo, issueNumber, $"Next steps:\n- {steps}");
        }
        
        // Add next interaction suggestion
        if (!string.IsNullOrEmpty(responseToStakeholder.NextInteractionSuggestion))
        {
            await ghService.PostComment(org, repo, issueNumber, $"Suggestion: {responseToStakeholder.NextInteractionSuggestion}");
        }
    }
    
    public async ValueTask HandleAsync(ValuePropositionProcessed valuePropositionProcessed, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);
        
        // Post the main response
        await ghService.PostComment(org, repo, issueNumber, valuePropositionProcessed.Response);
        
        // Post formalized value proposition
        if (!string.IsNullOrEmpty(valuePropositionProcessed.FormalizedValueProposition))
        {
            await ghService.PostComment(org, repo, issueNumber, $"**Value Proposition**:\n{valuePropositionProcessed.FormalizedValueProposition}");
        }
        
        // Post user stories
        if (valuePropositionProcessed.RelatedUserStories.Count > 0)
        {
            var stories = string.Join("\n- ", valuePropositionProcessed.RelatedUserStories);
            await ghService.PostComment(org, repo, issueNumber, $"**User Stories**:\n- {stories}");
        }
        
        // Post suggested metrics
        if (valuePropositionProcessed.SuggestedMetrics.Count > 0)
        {
            var metrics = string.Join("\n- ", valuePropositionProcessed.SuggestedMetrics);
            await ghService.PostComment(org, repo, issueNumber, $"**Suggested Metrics**:\n- {metrics}");
        }
        
        // Add next steps
        if (!string.IsNullOrEmpty(valuePropositionProcessed.NextSteps))
        {
            await ghService.PostComment(org, repo, issueNumber, $"**Next Steps**: {valuePropositionProcessed.NextSteps}");
        }
    }
    
    public async ValueTask HandleAsync(PrioritizationProcessed prioritizationProcessed, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);
        
        // Post the main response
        await ghService.PostComment(org, repo, issueNumber, prioritizationProcessed.Response);
        
        // Post backlog summary
        if (!string.IsNullOrEmpty(prioritizationProcessed.UpdatedBacklogSummary))
        {
            await ghService.PostComment(org, repo, issueNumber, $"**Updated Backlog**:\n```\n{prioritizationProcessed.UpdatedBacklogSummary}\n```");
        }
        
        // Post timeline impact
        if (prioritizationProcessed.ImpactOnTimeline.Count > 0)
        {
            var impacts = string.Join("\n- ", prioritizationProcessed.ImpactOnTimeline);
            await ghService.PostComment(org, repo, issueNumber, $"**Timeline Impact**:\n- {impacts}");
        }
        
        // Post potential conflicts
        if (prioritizationProcessed.PotentialConflicts.Count > 0)
        {
            var conflicts = string.Join("\n- ", prioritizationProcessed.PotentialConflicts);
            await ghService.PostComment(org, repo, issueNumber, $"**Potential Conflicts**:\n- {conflicts}");
        }
        
        // Add recommendation
        if (!string.IsNullOrEmpty(prioritizationProcessed.Recommendation))
        {
            await ghService.PostComment(org, repo, issueNumber, $"**Recommendation**: {prioritizationProcessed.Recommendation}");
        }
    }
    
    public async ValueTask HandleAsync(SprintFeedbackProcessed sprintFeedbackProcessed, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);
        
        // Post the main response
        await ghService.PostComment(org, repo, issueNumber, sprintFeedbackProcessed.Response);
        
        // Post feedback summary
        if (!string.IsNullOrEmpty(sprintFeedbackProcessed.FeedbackSummary))
        {
            await ghService.PostComment(org, repo, issueNumber, $"**Feedback Summary**:\n```\n{sprintFeedbackProcessed.FeedbackSummary}\n```");
        }
        
        // Post actionable items
        if (sprintFeedbackProcessed.ActionableItems.Count > 0)
        {
            var items = string.Join("\n- ", sprintFeedbackProcessed.ActionableItems);
            await ghService.PostComment(org, repo, issueNumber, $"**Actionable Items**:\n- {items}");
        }
        
        // Post backlog implications
        if (sprintFeedbackProcessed.BacklogImplications.Count > 0)
        {
            var implications = string.Join("\n- ", sprintFeedbackProcessed.BacklogImplications);
            await ghService.PostComment(org, repo, issueNumber, $"**Backlog Implications**:\n- {implications}");
        }
        
        // Add next sprint recommendations
        if (!string.IsNullOrEmpty(sprintFeedbackProcessed.NextSprintRecommendations))
        {
            await ghService.PostComment(org, repo, issueNumber, $"**Next Sprint Recommendations**: {sprintFeedbackProcessed.NextSprintRecommendations}");
        }
    }

    /// <summary>
    /// When a README.md file is generated, post it as a comment to the associated issue.
    /// </summary>
    /// <param name="readmeGenerated"></param>
    /// <param name="messageContext"></param>
    /// <returns></returns>
    public async ValueTask HandleAsync(ReadmeGenerated readmeGenerated, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);

        var contents = string.IsNullOrEmpty(readmeGenerated.Readme) ? "Sorry, I got tired, can you try again please? " : readmeGenerated.Readme;
        await ghService.PostComment(org, repo, issueNumber, contents);
    }

    /// <summary>
    /// When a DevPlan is "Generated", post it as a comment to the associated issue
    /// The user then has an opportunity to comment and provide additional guidance related to the original ask.
    /// </summary>
    /// <param name="devPlanGenerated"></param>
    /// <param name="messageContext"></param>
    /// <returns></returns>
    public async ValueTask HandleAsync(DevPlanGenerated devPlanGenerated, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);

        var contents = string.IsNullOrEmpty(devPlanGenerated.DevPlan) ? "Sorry, I got tired, can you try again please? " : devPlanGenerated.DevPlan;
        await ghService.PostComment(org, repo, issueNumber, contents);
    }

    /// <summary>
    /// When code is Generated, post a comment to the associated issue with the contents of the code
    /// </summary>
    /// <param name="codeGenerated"></param>
    /// <param name="messageContext"></param>
    /// <returns></returns>
    public async ValueTask HandleAsync(CodeGenerated codeGenerated, MessageContext messageContext)
    {
        var (org, repo, issueNumber, _) = ExtractDetailsFromTopicSource(messageContext.Topic);

        var contents = string.IsNullOrEmpty(codeGenerated.Code) ? "Sorry, I got tired, can you try again please? " : codeGenerated.Code;
        await ghService.PostComment(org, repo, issueNumber, contents);
    }

    /// <summary>
    /// When a DevPlan is "Created"
    /// </summary>
    /// <param name="devPlanCreated"></param>
    /// <param name="messageContext"></param>
    /// <returns></returns>
    public async ValueTask HandleAsync(DevPlanCreated devPlanCreated, MessageContext messageContext)
    {
        var (org, repo, issueNumber, parentIssueNumber) = ExtractDetailsFromTopicSource(messageContext.Topic);

        var plan = JsonSerializer.Deserialize<DevPlan>(devPlanCreated.DevPlan);
        var prompts = plan!.Steps.SelectMany(s => s.Subtasks!.Select(st => st.Prompt));

        foreach (var prompt in prompts)
        {
            var functionName = "Developer.Implement";
            var issue = await ghService.CreateIssue(org, repo, prompt!, functionName, issueNumber);
            var commentBody = $" - #{issue} - tracks {functionName}";
            await ghService.PostComment(org, repo, issueNumber, commentBody);
        }
    }

    public async ValueTask HandleAsync(ReadmeStored readmeStored, MessageContext messageContext)
    {
        var (org, repo, issueNumber, parentIssueNumber) = ExtractDetailsFromTopicSource(messageContext.Topic);
        var branch = $"sk-{issueNumber}";
        await ghService.CommitToBranch(org, repo, parentIssueNumber, issueNumber, "output", branch);
        await ghService.CreatePR(org, repo, issueNumber, branch);
    }

    private (string Org, string Repo, long IssueNumber, long ParentIssueNumber) ExtractDetailsFromTopicSource(TopicId? topicId)
    {
        if (string.IsNullOrEmpty(topicId?.Source))
        {
            throw new ArgumentNullException(nameof(topicId), "TopicId cannot be null");
        }

        // New robust parsing for key-value format: Org=...|Repo=...|IssueNumber=...|ParentIssueNumber=...
        var parts = topicId.Value.Source.Split('|', StringSplitOptions.RemoveEmptyEntries);
        string org = "", repo = "";
        long issueNumber = 0, parentIssueNumber = 0;

        foreach (var part in parts)
        {
            var kv = part.Split('=', 2);
            if (kv.Length != 2)
            {
                continue;
            }

            switch (kv[0])
            {
                case "Org":
                    org = kv[1];
                    break;
                case "Repo":
                    repo = kv[1];
                    break;
                case "IssueNumber":
                    issueNumber = TryParseLong(kv[1]);
                    break;
                case "ParentIssueNumber":
                    parentIssueNumber = TryParseLong(kv[1]);
                    break;
            }
        }

        return (org, repo, issueNumber, parentIssueNumber);
    }

    private long TryParseLong(object? value)
    {
        return long.TryParse(value?.ToString(), out var result) ? result : 0;
    }
}
